# Hassell and Varley (interference)
hv=function(Q,N,P,n,m,t){
(Q*(N^n)*P^(-m))/(1+Q*(N^n)*P^(-m)*t)
}
plot(holling(Q=1.5, t=0.02,N=seq(1,500,1), n=0.8,m=0.8,P=100, type=3))
plot(hv(Q=1.5, t=0.02,N=seq(1,500,1), n=0.8,m=0.8,P=100))
