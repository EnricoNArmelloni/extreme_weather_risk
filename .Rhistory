scriptPath <- rstudioapi::getSourceEditorContext()$path
scriptDir <- dirname(scriptPath)
#setwd(file.path(scriptDir, '..'))
library(tidyverse)
library(bnlearn)
library(readxl)
library(gRain)
theme_set(theme_bw())
net=read.net(file.path(scriptDir, '..','data/read_only/networks/BEWARE_learnt_r1_0_0.net'), debug = F)
net.node=nodes(net)
node.text=read_excel(file.path(scriptDir, '..','data/editable_files/nodes_text.xlsx'))
node.text=node.text[node.text$node %in% nodes(net), ]
#node.text[-which(node.text$node %in% nodes(net)), ]
#net.node[-which(net.node %in% node.text$node)]
#knitr::opts_chunk$set(fig.width=10, fig.height=5)
firstup <- function(x) {
substr(x, 1, 1) <- toupper(substr(x, 1, 1))
x
}
head_resp='##'
#target.nodes=c('infrastructure', 'flexibility', 'strategy', 'personal_safety', 'gear', 'target', 'catchability')
# function to create plots
create.plots=function(target.nodes, net){
# plot creation
plot.list=list()
for( i in 1:length(target.nodes)){
# get values
i.node=target.nodes[i]
array.var=net[[i.node]]$prob
df.var=as.data.frame(array.var)
xnam=dimnames(array.var)
x.parents=names(xnam)
x.parents=x.parents[x.parents!=i.node]
x.levs=xnam[[i.node]]
if("aware" %in% names(df.var)){
df.var=df.var[df.var$aware=='yes',]
}
# format
if('fishing_style' %in% names(df.var)){
df.var=df.var%>%
dplyr::mutate(fishing_style=ifelse(fishing_style=='recreational',
'rcf', ifelse(fishing_style=='small_scale', 'ssf',
ifelse(fishing_style=='coastal_salmon' , 'sal' ,
ifelse(fishing_style=='household' ,'hou',
ifelse(fishing_style=='trawler' ,'trw','fgu'))))))
}
if('target' %in% names(df.var)){
df.var=df.var%>%
dplyr::mutate(target=ifelse(target=='herring',
'HER', ifelse(target=='perch', 'FPE',
ifelse(target=='pike' , 'FPI' ,
ifelse(target=='salmon' ,'SAL',
ifelse(target=='sea_trout' ,'TRS',
ifelse(target=='whitefish', 'WHF','Other')))))))
}
# plotting
if(length(x.parents)==1){
p=ggplot(data=df.var, aes_string(x = x.parents[1], y = "Freq", fill = i.node))+
geom_col()
plot.lab='.'
}
if(length(x.parents)==2){
p=ggplot(data=df.var, aes_string(x = x.parents[1], y = "Freq", fill = i.node))+
geom_col()+
facet_grid(cols = vars(!!as.name(x.parents[2])))
plot.lab=paste0('. Columns represents levels of the node ', x.parents[2],'.')
}
if(length(x.parents)==3){
p= ggplot(data=df.var, aes_string(x = x.parents[1], y = "Freq", fill = i.node))+
geom_col()+
facet_grid(cols = vars(!!as.name(x.parents[2])),
rows = vars(!!as.name(x.parents[3])))+
scale_x_discrete(guide = guide_axis(n.dodge = 2))
plot.lab=paste0('. Columns represents levels of the node ', x.parents[2],'; rows are levels of the node ', x.parents[3],'.')
}
if(length(x.parents)==4){
p=ggplot(data=df.var, aes_string(x = x.parents[1], y = "Freq", fill = i.node))+
geom_col()+
facet_grid(cols = vars(!!as.name(x.parents[2])),
rows = vars(!!as.name(x.parents[3])))+
scale_x_discrete(guide = guide_axis(n.dodge = 2))
plot.lab=paste0('. Columns represents levels of the node ', x.parents[2],'; rows are levels of the node ', x.parents[3],'.')
}
plot.list[[i]]=p+theme(legend.position = 'bottom')
names(plot.list)[[i]] = c(paste0("conditional distribution for ", target.nodes[i], plot.lab))
}
return(plot.list)
}
knit.fun=function(target.nodes, net){
plot.list=create.plots(target.nodes = target.nodes, net=net)
for( i in 1:length(target.nodes)){
# get values
i.node=target.nodes[i]
array.var=net[[i.node]]$prob
df.var=as.data.frame(array.var)
xnam=dimnames(array.var)
x.parents=names(xnam)
x.parents=x.parents[x.parents!=i.node]
x.levs=xnam[[i.node]]
# print characteristics
cat("\n")
cat(sprintf('%s %s\n\n', head_resp, firstup(str_replace(i.node, '_',' '))))
cat("\n")
cat(sprintf('**Parents**: %s  \n', paste0(paste(x.parents, collapse = ', '),'.')))
cat("\n")
cat(sprintf('**Levels**: %s  \n', paste0(paste(x.levs, collapse = ', '),'.')))
# print description text
i.text=node.text[node.text$node==i.node,]
cat("\n")
cat(sprintf('**Description**: %s  \n', paste0(i.text$text ,'.')))
# print method text
i.text=node.text[node.text$node==i.node,]
cat("\n")
cat(sprintf('**Method**: %s  \n', paste0(i.text$method_text ,'.')))
# plotting
cat('\n\n')
chunk_text <- paste0(
"```{r, echo=FALSE, fig.width=10, fig.height=5, fig.pos='H', fig.cap='",
(names(plot.list)[i]),
"'}\n",
"print(plot.list[[", i, "]])\n",
"```\n"
)
cat(knitr::knit_child(text = chunk_text, envir = environment(),quiet = TRUE))
cat("\n\\newpage\n")
}
}
## compute importance - this adds later
array.var=net[['fishing_style']]$prob
xdim=dim(array.var)
array.var[1:xdim]=rep(1/(xdim), xdim)
#array.var[c(1,7)]=0
net[['fishing_style']]=array.var
fi.list=names(array.var[array.var>0])
scen.grid2=expand.grid(fishing_style=fi.list)
ev.store=NULL
for(i in 1:nrow(scen.grid2)){
i.res=cpdist(net, nodes = c('societal_importance', 'individual_importance','economic_buffers'),
evidence = list(fishing_style = as.character(scen.grid2[i,])),
n=10^5, method='lw')
i.res$fishing_style=as.character(scen.grid2[i,])
i.res=i.res%>%
pivot_longer(-c(fishing_style), names_to = 'node', values_to = 'est')%>%
dplyr::group_by(fishing_style, node,est)%>%
tally()%>%
dplyr::group_by(fishing_style,  node)%>%
dplyr::mutate(prob=n/sum(n))
ev.store=rbind(ev.store, i.res)
}
knit.fun(target.nodes = unique(node.text[node.text$group=='operational',]$node), net=net)
i.node='go_fishing'
array.var=net[[i.node]]$prob
df.var=as.data.frame(array.var)
xnam=dimnames(array.var)
x.parents=names(xnam)
x.parents=x.parents[x.parents!=i.node]
x.levs=xnam[[i.node]]
# format
if('fishing_style' %in% names(df.var)){
df.var=df.var%>%
dplyr::mutate(fishing_style=ifelse(fishing_style=='recreational',
'rcf', ifelse(fishing_style=='small_scale', 'ssf',
ifelse(fishing_style=='coastal_salmon' , 'sal' ,
ifelse(fishing_style=='household' ,'hou',
ifelse(fishing_style=='trawler' ,'trw','fgu'))))))
}
if('target' %in% names(df.var)){
df.var=df.var%>%
dplyr::mutate(target=ifelse(target=='herring',
'HER', ifelse(target=='perch', 'FPE',
ifelse(target=='pike' , 'FPI' ,
ifelse(target=='salmon' ,'SAL',
ifelse(target=='sea_trout' ,'TRS',
ifelse(target=='whitefish', 'WHF','Other')))))))
}
length(x.parents)
p=ggplot(data=df.var, aes_string(x = x.parents[1], y = "Freq", fill = i.node))+
geom_col()+
facet_grid(cols = vars(!!as.name(x.parents[2])),
rows = vars(!!as.name(x.parents[3])))+
scale_x_discrete(guide = guide_axis(n.dodge = 2))
plot.lab=paste0('. Columns represents levels of the node ', x.parents[2],'; rows are levels of the node ', x.parents[3],'.')
p
