res=changes.scenario(fcm.mat,fcm.lab,iter=50,set.concepts=c(fcm.lab[i]),set.values=c(vec[j]))
res$scenario=paste(i,j,sep='_')
store=rbind(store, res)
}
}
ggplot(data=store, aes(x=Concept, y=Equilibrium_value, fill=factor(scenario)))+
geom_col(position='dodge')+
facet_wrap(~Concept, scales='free')
