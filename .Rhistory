"Change_location", "Change_species", "Change_practices", "Gear_infrastructure", "Regulations",
# Impacts / risks
"Safety_risk", "Gear_damage", "Economic_impact", "Stress",
# Values
"Societal_contribution", "Tradition_identity", "Well_being"
)
# Specify the arcs (directed edges) following the conceptual DAG:
arcs <- matrix(
c(
# Weather -> Fishing outcomes
"Heatwave_summer","Likelihood_fishing",
"Heatwave_winter","Likelihood_fishing",
"Severe_icing","Likelihood_fishing",
"Algal_bloom","Likelihood_fishing",
"Cloudburst","Likelihood_fishing",
"Gale","Likelihood_fishing",
"Storm","Likelihood_fishing",
"Heatwave_summer","Catchability",
"Heatwave_summer","Species_composition",
"Heatwave_summer","Fish_quality",
"Heatwave_winter","Catchability",
"Severe_icing","Catchability",
"Algal_bloom","Catchability",
"Cloudburst","Catchability",
"Gale","Catchability",
"Storm","Catchability",
# Weather -> Impacts
"Gale","Gear_damage",
"Storm","Gear_damage",
"Cloudburst","Gear_damage",
"Severe_icing","Gear_damage",
"Heatwave_summer","Fish_quality",
# Fishing outcomes -> Adaptation
"Likelihood_fishing","Change_location",
"Likelihood_fishing","Change_species",
"Catchability","Change_practices",
"Species_composition","Change_species",
"Fish_quality","Change_practices",
"Long_term_effects","Change_practices",
# Adaptation -> Impacts
"Change_location","Economic_impact",
"Change_species","Economic_impact",
"Gear_infrastructure","Change_location",
"Regulations","Change_species",
"Gear_infrastructure","Gear_damage",
# Outcomes & impacts -> Values
"Long_term_effects","Tradition_identity",
"Economic_impact","Societal_contribution",
"Gear_damage","Stress",
"Safety_risk","Stress",
"Stress","Well_being",
"Tradition_identity","Well_being"
),
byrow = TRUE, ncol = 2, dimnames = list(NULL, c("from","to"))
)
# Create the network from the arc list
dag_questionnaire <- empty.graph(nodes)
arcs(dag_questionnaire) <- arcs
# Quick plot (requires Rgraphviz)
graphviz.plot(dag_questionnaire, main = "Questionnaire-derived DAG")
# Quick plot (requires Rgraphviz)
graphviz.plot(dag_questionnaire, main = "Questionnaire-derived DAG")
# === 4) Fit CPTs ===
# If you have data: use bn.fit on a learned structure
if (exists("dat") && exists("avg_net")) {
fitted_bn <- bn.fit(avg_net, data = dat)
# Inspect CPT for a node
print(fitted_bn$Likelihood_fishing)
} else {
# Example: manually construct a small CPT and build a fitted bn (for demonstration)
# Here we create a very small, illustrative CPT for Likelihood_fishing given Storm and Gale
# Note: bn.fit with custom CPTs needs bn.fit object creation via custom.fit
nodes_small <- c("Storm", "Gale", "Likelihood_fishing")
g_small <- empty.graph(nodes_small)
arcs(g_small) <- matrix(c("Storm","Likelihood_fishing","Gale","Likelihood_fishing"), byrow=TRUE, ncol=2)
# Define levels (discrete states)
lvl <- list(Storm = c("no","yes"), Gale = c("no","yes"), Likelihood_fishing = c("low","high"))
# Create CPT as table: P(Likelihood | Storm, Gale)
# Dimensions must be in order: Likelihood_fishing x Storm x Gale
cpt_L <- array(0, dim = c(2,2,2), dimnames = list(Likelihood_fishing = lvl$Likelihood_fishing, Storm = lvl$Storm, Gale = lvl$Gale))
# Fill with plausible numbers (must sum to 1 over Likelihood_fishing for each parent combination)
# When no storm and no gale -> high likelihood
cpt_L[,"no","no"] <- c(0.2, 0.8)
# Storm only -> low likelihood
cpt_L[,"yes","no"] <- c(0.9, 0.1)
# Gale only -> low-moderate
cpt_L[,"no","yes"] <- c(0.7, 0.3)
# Both storm and gale -> very low
cpt_L[,"yes","yes"] <- c(0.95, 0.05)
# Assemble bn.fit object for the small net
cpd_list <- list(
Storm = list(prob = c(no = 0.9, yes = 0.1)),     # prior for Storm
Gale = list(prob = c(no = 0.8, yes = 0.2)),      # prior for Gale
Likelihood_fishing = list(cpt = cpt_L)
)
fitted_small <- custom.fit(g_small, dist = cpd_list)
print(fitted_small$Likelihood_fishing)
# Save small BN plot
png("small_manual_bn.png", width=800, height=600)
graphviz.plot(fitted_small, main = "Manual BN example (Storm/Gale -> Likelihood)")
dev.off()
}
# === 2) If you have a dataset (.csv) with questionnaire responses, learn a DAG from data ===
# Set path to your CSV - expected: each column corresponds to a node name (or map columns to these names)
data_path <- "responses.csv"   # <--- change this to your file, or leave as-is if you don't have one
if (file.exists(data_path)) {
dat <- read.csv(data_path, stringsAsFactors = TRUE)  # categorical data preferred for bnlearn discrete algorithms
# OPTIONAL: if your data are numeric but represent ordinal categories,
# discretize using discretize() or cut() before learning.
#
# e.g. dat$Likelihood_fishing <- as.factor(dat$Likelihood_fishing)
#
# Make sure dat column names match nodes (or rename)
cat("Columns in data:\n"); print(colnames(dat))
# Learn structure with several algorithms and compare
set.seed(2025)
bn_hc <- hc(dat, score = "bic")         # hill-climbing score-based
bn_tabu <- tabu(dat, score = "bic")     # tabu search
bn_gs <- gs(dat)                        # constraint-based Grow-Shrink
bn_mmhc <- mmhc(dat)                    # hybrid (constraint + score)
# Strength via bootstrap to get arc probabilities
boot <- boot.strength(dat, R = 200, algorithm = "hc", algorithm.args = list(score = "bic"))
avg_net <- averaged.network(boot, threshold = 0.5)  # keep arcs with strength >= 0.5
# Plot learned network(s)
graphviz.plot(bn_hc, main = "HC learned DAG")
graphviz.plot(avg_net, main = "Averaged network (bootstrap)")
png("learned_dag_hc.png", width=1400, height=1000)
graphviz.plot(bn_hc, main = "HC learned DAG")
dev.off()
png("learned_dag_avg.png", width=1400, height=1000)
graphviz.plot(avg_net, main = "Averaged network (bootstrap)")
dev.off()
} else {
message("No dataset found at '", data_path, "'. Skip structure learning. Provide a CSV to run data-driven learning.")
}
# === 3) Compare your (questionnaire) DAG to a learned DAG (if available) OR to a user DAG file ===
# If you have your own DAG saved as edges (edge list or adjacency), you can read it and compare.
# Example: read an edge-list CSV with columns 'from','to'
user_dag_path <- "user_dag_edges.csv"  # 2-col CSV with from,to - optional
if (file.exists(user_dag_path)) {
user_edges <- read.csv(user_dag_path, stringsAsFactors = FALSE)
dag_user <- empty.graph(nodes)
arcs(dag_user) <- as.matrix(user_edges)
# Structural Hamming distance (SHD)
shd_value <- shd(dag_questionnaire, dag_user)
cat("Structural Hamming Distance between questionnaire DAG and user's DAG:", shd_value, "\n")
# Difference in arc sets
arcs_q <- arcs(dag_questionnaire); arcs_u <- arcs(dag_user)
added_by_user <- setdiff(as.data.frame(arcs_u), as.data.frame(arcs_q))
missing_in_user <- setdiff(as.data.frame(arcs_q), as.data.frame(arcs_u))
cat("Arcs in user's DAG but not in questionnaire DAG:\n"); print(added_by_user)
cat("Arcs in questionnaire DAG but missing in user's DAG:\n"); print(missing_in_user)
} else if (exists("avg_net")) {
# Compare questionnaire DAG to the averaged learned network
shd_value <- shd(dag_questionnaire, avg_net)
cat("SHD between questionnaire DAG and averaged learned DAG:", shd_value, "\n")
cat("Arcs in questionnaire DAG:\n"); print(arcs(dag_questionnaire))
cat("Arcs in averaged learned DAG:\n"); print(arcs(avg_net))
# show arcs present in one but not the other
q_arcs_df <- as.data.frame(arcs(dag_questionnaire)); avg_arcs_df <- as.data.frame(arcs(avg_net))
cat("Arcs questionnaire \\ averaged-only:\n"); print(setdiff(q_arcs_df, avg_arcs_df))
cat("Arcs averaged \\ questionnaire-only:\n"); print(setdiff(avg_arcs_df, q_arcs_df))
} else {
message("No user DAG or learned network available to compare. Provide 'user_dag_edges.csv' or a data CSV to compare.")
}
# === 4) Fit CPTs ===
# If you have data: use bn.fit on a learned structure
if (exists("dat") && exists("avg_net")) {
fitted_bn <- bn.fit(avg_net, data = dat)
# Inspect CPT for a node
print(fitted_bn$Likelihood_fishing)
} else {
# Example: manually construct a small CPT and build a fitted bn (for demonstration)
# Here we create a very small, illustrative CPT for Likelihood_fishing given Storm and Gale
# Note: bn.fit with custom CPTs needs bn.fit object creation via custom.fit
nodes_small <- c("Storm", "Gale", "Likelihood_fishing")
g_small <- empty.graph(nodes_small)
arcs(g_small) <- matrix(c("Storm","Likelihood_fishing","Gale","Likelihood_fishing"), byrow=TRUE, ncol=2)
# Define levels (discrete states)
lvl <- list(Storm = c("no","yes"), Gale = c("no","yes"), Likelihood_fishing = c("low","high"))
# Create CPT as table: P(Likelihood | Storm, Gale)
# Dimensions must be in order: Likelihood_fishing x Storm x Gale
cpt_L <- array(0, dim = c(2,2,2), dimnames = list(Likelihood_fishing = lvl$Likelihood_fishing, Storm = lvl$Storm, Gale = lvl$Gale))
# Fill with plausible numbers (must sum to 1 over Likelihood_fishing for each parent combination)
# When no storm and no gale -> high likelihood
cpt_L[,"no","no"] <- c(0.2, 0.8)
# Storm only -> low likelihood
cpt_L[,"yes","no"] <- c(0.9, 0.1)
# Gale only -> low-moderate
cpt_L[,"no","yes"] <- c(0.7, 0.3)
# Both storm and gale -> very low
cpt_L[,"yes","yes"] <- c(0.95, 0.05)
# Assemble bn.fit object for the small net
cpd_list <- list(
Storm = list(prob = c(no = 0.9, yes = 0.1)),     # prior for Storm
Gale = list(prob = c(no = 0.8, yes = 0.2)),      # prior for Gale
Likelihood_fishing = list(cpt = cpt_L)
)
fitted_small <- custom.fit(g_small, dist = cpd_list)
print(fitted_small$Likelihood_fishing)
# Save small BN plot
png("small_manual_bn.png", width=800, height=600)
graphviz.plot(fitted_small, main = "Manual BN example (Storm/Gale -> Likelihood)")
dev.off()
}
# === 5) Useful diagnostics & utilities ===
# Structural Hamming Distance function used above: shd(net1, net2)
# Arc strength (if bootstrap result exists)
if (exists("boot")) {
print(head(boot[order(-boot$strength), ], 20))
}
holling=function(b,N,t,N){
if(type==2){
# Type 2
FR=(b*N)/(1+b*t*N)
}
if(type==3){
# Type 3
FR=(b*N^2)/(1+b*t*N^2)
}
return(FR)
}
holling=function(b,N,t,N){
if(type==2){
# Type 2
FR=(b*N)/(1+b*t*N)
}
if(type==3){
# Type 3
FR=(b*N^2)/(1+b*t*N^2)
}
return(FR)
}
# Holling ####
holling=function(b,N,t){
if(type==2){
# Type 2
FR=(b*N)/(1+b*t*N)
}
if(type==3){
# Type 3
FR=(b*N^2)/(1+b*t*N^2)
}
return(FR)
}
# Holling ####
holling=function(b,N,t){
# arguments: b is attack rate, N is number of prey, t is handling time. Therefore bN is number of prey captured per units search
if(type==2){
# Type 2
FR=(b*N)/(1+b*t*N)
}
if(type==3){
# Type 3
FR=(b*N^2)/(1+b*t*N^2)
}
return(FR)
}
holling(b=0.1, t=2,N=100)
holling(b=0.1, t=2,N=100, type=1)
# Holling ####
holling=function(b,N,t, type){
# arguments: b is attack rate, N is number of prey, t is handling time. Therefore bN is number of prey captured per units search
if(type==2){
# Type 2
FR=(b*N)/(1+b*t*N)
}
if(type==3){
# Type 3
FR=(b*N^2)/(1+b*t*N^2)
}
return(FR)
}
